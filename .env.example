# Database
DATABASE_URL="postgresql://user:password@localhost:5432/igura_marketplace"

# Authentication
JWT_SECRET="generate-a-secure-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage (no longer used for property media — kept only if you
# reintroduce a feature that needs it; images/video now go to Cloudinary)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudinary (property images & videos)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Cloudflare R2 fallback for property images and verified media uploads.
# Use a public bucket URL only; never expose the access key or secret to the browser.
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET="igura"
CLOUDFLARE_R2_PUBLIC_URL="https://your-public-r2-domain"

# Payment - Flutterwave (legacy checkout links; kept as fallback)
FLUTTERWAVE_SECRET_KEY="your-flutterwave-secret-key"
FLUTTERWAVE_PUBLIC_KEY="your-flutterwave-public-key"
FLUTTERWAVE_ENCRYPTION_KEY="your-encryption-key"
FLUTTERWAVE_WEBHOOK_SECRET="your-webhook-secret"

# Payments provider switch: "quicko" (Quicko Collections -> MTN MoMo) or
# "flutterwave" (legacy checkout links, kept as fallback).
PAYMENTS_PROVIDER="quicko"

# Launch monetization: "free" lets authenticated users reveal contacts and
# gives commissionaires the free listing allowance. Set to "live" when paid
# plans and contact-reveal charges should be enforced.
MONETIZATION_MODE="free"
CRON_SECRET="generate-a-long-random-cron-secret"

# Payment - Quicko Collections (Rwanda live). Values come from the Quicko
# dashboard (API keys section); never commit real ones. The API ID must be
# stored/used UPPERCASE — Quicko rejects the lowercase UUID with
# "Api Id Invalid!". Server env names are QUICKO_API_KEY / QUICKO_API_ID.
QUICKO_BASE_URL="https://pay.quicko.rw"
QUICKO_API_KEY="your-ccore_live-key"
QUICKO_API_ID="your-uppercase-api-id"

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"

# Email (optional for V1)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Seed script (npm run db:seed) — creates the initial admin account.
# Required the first time you seed; not read anywhere else.
SEED_ADMIN_EMAIL="admin@igura.rw"
SEED_ADMIN_PASSWORD="choose-a-strong-password-min-8-chars"
